---
interface Props {
  platform: "android" | "ios";
  title: string;
  comingSoon?: boolean;
}

const { platform, title, comingSoon = false } = Astro.props;
---

<article
  class:list={[
    "flex flex-col items-center rounded-3xl border border-ink-900/8 p-8 text-center md:p-10",
    comingSoon ? "bg-cream-25" : "bg-white shadow-sm",
  ]}
>
  <span
    class:list={[
      "grid size-16 place-items-center rounded-2xl",
      comingSoon ? "bg-cream-100 text-ink-500" : "bg-forest-900 text-lime-400",
    ]}
  >
    {platform === "android" ? (
      <svg viewBox="0 0 24 24" fill="currentColor" class="size-8" aria-hidden="true">
        <path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.66-.38l-1.86 3.22a11.4 11.4 0 0 0-9.84 0L5.22 5.92a.38.38 0 0 0-.66.38L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" fill="currentColor" class="size-8" aria-hidden="true">
        <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-2.99-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.89 1.15 9.14.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.24-.02 2.02-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.41-3.66zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.06-.52 2.69-1.28z" />
      </svg>
    )}
  </span>

  <h2 class="mt-6 font-display text-2xl text-ink-900 md:text-3xl">{title}</h2>

  <div class="mt-6 flex w-full flex-1 flex-col items-center justify-center gap-4">
    <slot />
  </div>
</article>
